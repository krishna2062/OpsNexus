# ==============================================================================
# OPSNEXUS ENTERPRISE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Port & Server Environment
PORT=3000
NODE_ENV=development

# Application & Backend URLs
APP_URL="http://localhost:3000"
VITE_APP_URL="http://localhost:3000"
VITE_API_URL="/api"

# JWT Authentication Secrets (Replace in production with secure random 32+ character strings)
JWT_SECRET="replace_with_your_super_secure_jwt_secret_key_prod_2026"
JWT_REFRESH_SECRET="replace_with_your_super_secure_refresh_secret_key_prod_2026"

# Database & Supabase PostgreSQL Configuration
# If provided, the backend connects directly to your live Supabase project & storage.
# If omitted or not configured yet, the backend automatically uses the embedded high-performance
# relational persistence engine to allow immediate offline/local operation and full functionality.
DATABASE_URL="postgresql://postgres:password@db.projectref.supabase.co:5432/postgres"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Client-Safe Supabase Configuration for Frontend
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# AI & Gemini Integration
GEMINI_API_KEY="your-gemini-api-key"
